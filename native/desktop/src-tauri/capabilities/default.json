{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-dashboard",
  "description": "Full local companion controls are restricted to the trusted dashboard window.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-agent-status",
    "allow-agent-enroll",
    "allow-agent-start",
    "allow-agent-stop",
    "allow-agent-recent-decisions",
    "allow-authorize-note-root",
    "allow-revoke-note-root",
    "allow-set-auto-note-creation",
    "allow-set-foreground-window-context",
    "allow-owner-context-list",
    "allow-owner-context-upsert",
    "allow-owner-context-delete",
    "allow-pending-actions",
    "allow-approve-action",
    "allow-reject-action",
    "allow-set-startup",
    "allow-get-startup",
    "allow-toggle-avatar",
    "allow-show-dashboard",
    "allow-avatar-speak",
    "allow-voice-status",
    "allow-voice-start",
    "allow-voice-shutdown",
    "allow-voice-set-preferred",
    "allow-voice-speak",
    "allow-voice-cancel",
    "allow-voice-transcribe",
    "allow-provider-http-stream",
    "allow-provider-http-cancel",
    "allow-provider-has-credential",
    "allow-realtime-client-secret",
    "allow-chatgpt-sign-in",
    "allow-chatgpt-account",
    "allow-chatgpt-sign-out",
    "allow-chatgpt-models",
    "allow-openrouter-pair-start",
    "allow-openrouter-pair-complete",
    "allow-desktop-propose",
    "allow-desktop-run",
    "allow-desktop-approve",
    "allow-desktop-reject",
    "allow-desktop-audit",
    "allow-capture-screen",
    "allow-schedule-sync",
    "allow-agent-stream-open",
    "allow-agent-events-after",
    "allow-agent-stream-ack",
    "allow-agent-stream-close",
    "allow-credential-set",
    "allow-credential-get",
    "allow-credential-delete"
  ]
}
