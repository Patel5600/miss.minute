# Rust build outputs
/target/
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
miss-minute-agent.json

# Voice cloning: source clips, model weights, voice embeddings and generated
# audio stay on this machine. The reference voice is a third-party performance;
# never commit or redistribute it or anything derived from it.
/assets/
# Portable build tools (Strawberry Perl for the vendored OpenSSL build). Not committed.
/.tools/

# Processed copies of the owner's Miss Minutes art (generated by scripts/prepare_assets.py)
# and scratch reference material. Third-party artwork: never commit or redistribute.
/public/mm/
/.work/
# Agent workflow task briefs, progress files and review reports
/.agents/
# Dev-only QA pages (?qa=<name>)
/src/qa/

# Tauri host build output, regenerated on every build
native/desktop/target/
native/desktop/src-tauri/gen/
native/desktop/src-tauri/permissions/autogenerated/
native/voice/.venv/
native/voice/models/
native/voice/work/
native/voice/previews/
native/voice/**/__pycache__/

# Voice clone material (reference clips, speaker embeddings, generated audio)
# and local model weights stay on this machine. Never commit or push them.
native/voice/**/*.wav
native/voice/**/*.mp3
native/voice/**/*.flac
native/voice/**/*.ogg
native/voice/**/*.m4a
native/voice/**/*.webm
native/voice/**/*.npy
native/voice/**/*.npz
native/voice/**/*.pt
native/voice/**/*.pth
